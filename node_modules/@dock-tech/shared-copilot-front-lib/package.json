{
  "name": "@dock-tech/shared-copilot-front-lib",
  "version": "1.0.11",
  "description": "Configuração compartilhada de Copilot Instructions, Prompts, Agents, custom ESLint rules e validação do Design System",
  "author": {
    "name": "Brayhon Carvalho",
    "email": "brayhon.carvalho@dock.tech"
  },
  "maintainers": [
    {
      "name": "Brayhon Carvalho",
      "email": "brayhon.carvalho@dock.tech"
    }
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dock-tech/shared-copilot-front-lib.git"
  },
  "bin": {
    "shared-copilot-front-lib": "copilot-config/scripts/init.mjs"
  },
  "exports": {
    ".": {
      "default": "./copilot-config/eslint-plugin.js"
    },
    "./eslint-plugin": {
      "import": "./copilot-config/eslint-plugin.js",
      "require": "./copilot-config/eslint-plugin.js",
      "default": "./copilot-config/eslint-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "copilot-config/base/",
    "copilot-config/scripts/",
    "copilot-config/schemas/",
    "copilot-config/templates/",
    "copilot-config/eslint-plugin.js",
    "copilot-config/eslint-plugin-dock-ds/"
  ],
  "scripts": {
    "check:nexus-auth": "node copilot-config/scripts/check-nexus-auth.mjs",
    "build:dev": "npm --prefix copilot-config run test:instructions",
    "build:prod": "npm --prefix copilot-config run test:instructions",
    "build": "npm --prefix copilot-config run test:instructions",
    "test": "node copilot-config/tests/instruction-tests.mjs",
    "validate": "npm --prefix copilot-config run test:instructions"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0",
    "vue-eslint-parser": ">=9.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dock",
    "copilot",
    "design-system",
    "eslint",
    "instructions"
  ],
  "devDependencies": {
    "jest-junit": "^17.0.0",
    "jest-sonar-reporter": "^2.0.0"
  }
}
