{
  "$schema": "./node_modules/@dock-tech/shared-copilot-front-lib/schemas/dock-ds-config.schema.json",
  "extends": "@dock-tech/shared-copilot-front-lib/base",
  "version": "1.0.0",
  "designSystem": "storybook",
  "project": {
    "name": "{{PROJECT_NAME}}",
    "type": "landing-page",
    "framework": "vue3-vite-tailwind"
  },
  "tokens": {
    "colors": [
      "#00d8d8",
      "#1cc0c0",
      "#eeff88",
      "#444746",
      "#242424",
      "#5c5c5c",
      "#777777",
      "#e6e6e6",
      "#000000",
      "#ffffff",
      "#b9b9b9",
      "#dc3545"
    ],
    "fonts": {
      "allowed": ["Roboto", "Red Hat Display"],
      "banned": ["Poppins", "Inter", "Arial", "Helvetica", "Open Sans", "Lato", "Nunito"]
    },
    "typography": {
      "headingFont": "Roboto",
      "bodyFont": "Roboto",
      "ctaFont": "Red Hat Display",
      "weights": [300, 400, 500, 600, 700]
    }
  },
  "components": {
    "package": "shared-design-system-vue-lib",
    "styleImport": "shared-design-system-vue-lib/style.css",
    "preferImport": [
      "DsButton",
      "DsInput",
      "DsSelect",
      "DsStepper",
      "DockTypography",
      "DsCard"
    ]
  },
  "validation": {
    "scripts": {
      "design": "npm run validate:design",
      "a11y": "npm run test:a11y",
      "unit": "npm run test",
      "lint": "npm run lint:gate",
      "pipeline": "npm run validate"
    },
    "contrastMinimum": {
      "normalText": 4.5,
      "largeText": 3,
      "uiComponents": 3
    }
  },
  "figma": {
    "fileId": null,
    "designSystemDoc": "./DESIGN_SYSTEM.md",
    "nodeDataFile": "./figma-node-data.json"
  },
  "rules": {
    "slider": {
      "thumbColor": "#ffffff",
      "thumbSize": "24x24",
      "thumbBorderRadius": "0",
      "trackColor": "#b9b9b9",
      "trackHeight": "10px",
      "buttonOrder": "minus-left-plus-right"
    },
    "backgrounds": {
      "fullWidth": true,
      "noLateralMargins": true
    },
    "mobile": {
      "minWidth": 375,
      "maxWidth": 414,
      "containerClass": "w-full max-w-[414px] mx-auto"
    }
  }
}
