{
  "$schema": "./node_modules/@dock-tech/shared-copilot-front-lib/schemas/dock-ds-config.schema.json",
  "extends": "@dock-tech/shared-copilot-front-lib/base",
  "version": "1.0.0",
  "designSystem": "storybook",
  "project": {
    "name": "{{PROJECT_NAME}}",
    "type": "console-app",
    "framework": "vue3-vite-tailwind"
  },
  "tokens": {
    "colors": [
      "#00d8d8",
      "#1cc0c0",
      "#242424",
      "#5c5c5c",
      "#777777",
      "#e6e6e6",
      "#000000",
      "#ffffff",
      "#f8f9fa",
      "#dee2e6",
      "#333333",
      "#dc3545",
      "#28a745",
      "#ffc107",
      "#17a2b8",
      "#6c757d"
    ],
    "fonts": {
      "allowed": ["Roboto", "Red Hat Display"],
      "banned": ["Poppins", "Inter", "Arial", "Helvetica", "Open Sans", "Lato", "Nunito"]
    },
    "typography": {
      "headingFont": "Roboto",
      "bodyFont": "Roboto",
      "ctaFont": "Red Hat Display",
      "weights": [400, 500, 600, 700]
    }
  },
  "components": {
    "package": "shared-design-system-vue-lib",
    "styleImport": "shared-design-system-vue-lib/style.css",
    "preferImport": [
      "DsButton",
      "DsInput",
      "DsSelect",
      "DockTable",
      "DockModal",
      "DsCard",
      "DsStepper",
      "DockTypography",
      "DockPagination",
      "DockBadge",
      "DockTabs",
      "DsToast",
      "DockSidebar",
      "DockDropdown"
    ]
  },
  "validation": {
    "scripts": {
      "design": "npm run validate:design",
      "a11y": "npm run test:a11y",
      "unit": "npm run test",
      "lint": "npm run lint:gate",
      "pipeline": "npm run validate"
    },
    "contrastMinimum": {
      "normalText": 4.5,
      "largeText": 3,
      "uiComponents": 3
    }
  },
  "figma": {
    "fileId": null,
    "designSystemDoc": null,
    "nodeDataFile": null
  },
  "rules": {
    "tables": {
      "useDsTable": true,
      "pagination": true,
      "emptyState": true,
      "loading": true
    },
    "forms": {
      "maskRequired": true,
      "inlineErrors": true,
      "submitGuard": true
    },
    "layout": {
      "sidebar": true,
      "responsive": true,
      "breakpoints": ["sm:640", "md:768", "lg:1024", "xl:1280"]
    }
  }
}
